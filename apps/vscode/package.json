{
  "name": "kimi-code-kaif",
  "publisher": "mikalai-kryvusha",
  "displayName": "KIMI KRINIK",
  "description": "An improved and advanced Kimi Code extension for VS Code based on vanilla Kimi Code and Kimi Fork",
  "version": "1.0.0",
  "buildNumber": 43,
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikalaiKryvusha/KIMI-KRINIK-VSCODE-EXTENSION.git",
    "directory": "apps/vscode"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "assistant",
    "code",
    "chat",
    "agent",
    "mcp",
    "skills",
    "json",
    "autocomplete",
    "moonshot",
    "kimi",
    "moonshot-ai"
  ],
  "pricing": "Free",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "icon": "resources/kimi-icon-storefront.png",
  "contributes": {
    "configuration": {
      "title": "KIMI KRINIK",
      "properties": {
        "kimi.yoloMode": {
          "type": "boolean",
          "default": false,
          "description": "Auto-approve regular tool calls; the agent may still ask questions"
        },
        "kimi.autosave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save files before Kimi reads or writes them"
        },
        "kimi.enableNewConversationShortcut": {
          "type": "boolean",
          "default": false,
          "description": "Use Cmd/Ctrl+N to start a new conversation when Kimi is focused"
        },
        "kimi.useCtrlEnterToSend": {
          "type": "boolean",
          "default": false,
          "description": "Use Ctrl/Cmd+Enter to send prompts instead of Enter"
        },
        "kimi.language": {
          "type": "string",
          "enum": [
            "en",
            "zh",
            "ru"
          ],
          "enumDescriptions": [
            "English",
            "中文",
            "Русский"
          ],
          "default": "en",
          "description": "Interface language of KIMI KRINIK."
        },
        "kimi.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable all KIMI KRINIK attention sounds. Per-event sound and volume choices are preserved while this is off."
        },
        "kimi.sounds": {
          "type": "object",
          "default": {
            "approval": {
              "sound": "voice",
              "volume": 80
            },
            "question": {
              "sound": "voice",
              "volume": 80
            },
            "error": {
              "sound": "voice",
              "volume": 80
            },
            "turnComplete": {
              "sound": "off",
              "volume": 60
            }
          },
          "description": "Sound and volume (0-100) for each attention event: approval, question, error and turnComplete. A sound is voice, chime, bell, pop, alert or off. Change it in the Sound Settings window of the settings menu."
        },
        "kimi.autoSteer": {
          "type": "boolean",
          "default": true,
          "description": "Steer: a message sent during a running turn joins that turn at once. Off: the message waits in the queue until the turn ends."
        },
        "kimi.contextWindowControl": {
          "type": "boolean",
          "default": false,
          "description": "Notify the agent when context window usage reaches the configured thresholds. This works with or without automatic compaction; turn Compact off for fully manual context management."
        },
        "kimi.controlPanel.permission": {
          "type": "boolean",
          "default": true,
          "description": "Show the permission-mode button in Control Panel. Hiding the button does not change the permission mode."
        },
        "kimi.controlPanel.compact": {
          "type": "boolean",
          "default": true,
          "description": "Show the Compact button in Control Panel. Hiding the button does not change Auto Compact."
        },
        "kimi.controlPanel.steer": {
          "type": "boolean",
          "default": true,
          "description": "Show the Steer button in Control Panel. Hiding the button does not change Steer."
        },
        "kimi.controlPanel.control": {
          "type": "boolean",
          "default": true,
          "description": "Show the Control button in Control Panel. Hiding the button does not change Context Window Control."
        },
        "kimi.controlPanel.skills": {
          "type": "boolean",
          "default": true,
          "description": "Show the Skill button in Control Panel. Hiding the button does not disable skills or slash commands."
        },
        "kimi.controlPanel.plan": {
          "type": "boolean",
          "default": true,
          "description": "Show the Plan button in Control Panel. Hiding the button does not change Plan mode."
        },
        "kimi.controlPanel.goal": {
          "type": "boolean",
          "default": true,
          "description": "Show the Goal button in Control Panel. Hiding the button does not change the current goal."
        },
        "kimi.controlPanel.swarm": {
          "type": "boolean",
          "default": true,
          "description": "Show the Swarm button in Control Panel. Hiding the button does not change Swarm mode."
        },
        "kimi.controlPanel.secondaryModel": {
          "type": "boolean",
          "default": true,
          "description": "Show the secondary-model robot in Control Panel. Hiding the button does not change the selected secondary model."
        },
        "kimi.controlPanelOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "permission",
              "skills",
              "compact",
              "steer",
              "control",
              "plan",
              "goal",
              "swarm",
              "secondaryModel"
            ]
          },
          "uniqueItems": true,
          "default": [
            "permission",
            "skills",
            "compact",
            "steer",
            "control",
            "plan",
            "goal",
            "swarm",
            "secondaryModel"
          ],
          "description": "Control Panel button order from left to right. The Control Panel settings window provides Up and Down chevrons."
        },
        "kimi.kaif.warnPercent": {
          "type": "number",
          "default": 70,
          "minimum": 0,
          "maximum": 100,
          "description": "Context Window Control warning threshold, in percent of Kimi's compaction point. Only the defaults 70 / 75 / 80 / 90 are guaranteed."
        },
        "kimi.kaif.cutPercent": {
          "type": "number",
          "default": 75,
          "minimum": 0,
          "maximum": 100,
          "description": "Context Window Control logical-cut threshold, in percent of Kimi's compaction point. Only the defaults 70 / 75 / 80 / 90 are guaranteed."
        },
        "kimi.kaif.closePercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "description": "Context Window Control soft-closure threshold, in percent of Kimi's compaction point. Only the defaults 70 / 75 / 80 / 90 are guaranteed."
        },
        "kimi.kaif.forcePercent": {
          "type": "number",
          "default": 90,
          "minimum": 0,
          "maximum": 100,
          "description": "Context Window Control forced-closure threshold, in percent of Kimi's compaction point. Only the defaults 70 / 75 / 80 / 90 are guaranteed."
        },
        "kimi.attentionVoiceCommand": {
          "type": "array",
          "scope": "machine",
          "default": [],
          "description": "Command used to play attention messages; {file} is replaced with the phrase file"
        },
        "kimi.showThinkingContent": {
          "type": "boolean",
          "default": true,
          "description": "Show thinking/reasoning content in the chat UI"
        },
        "kimi.showThinkingExpanded": {
          "type": "boolean",
          "default": false,
          "description": "Auto-expand thinking/reasoning sections when shown (requires 'Show Thinking Content' to be enabled)"
        },
        "kimi.editorContext": {
          "type": "string",
          "default": "never",
          "enum": [
            "never",
            "onConversationStart",
            "onFileChange"
          ],
          "enumDescriptions": [
            "Never share editor context",
            "Share once when conversation starts",
            "Share when active file changes"
          ],
          "description": "Control when to share the active editor's file and cursor position with Kimi"
        }
      }
    },
    "commands": [
      {
        "command": "kimiKaif.clearAllState",
        "title": "KIMI KRINIK: [DEBUG] Clear All State"
      },
      {
        "command": "kimiKaif.openInTab",
        "title": "KIMI KRINIK: Open in New Tab",
        "icon": "$(link-external)"
      },
      {
        "command": "kimiKaif.openInSideBar",
        "title": "KIMI KRINIK: Open in Side Panel",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "kimiKaif.focusInput",
        "title": "KIMI KRINIK: Focus Input",
        "icon": "$(edit)"
      },
      {
        "command": "kimiKaif.insertMention",
        "title": "KIMI KRINIK: Insert Current File",
        "icon": "$(mention)"
      },
      {
        "command": "kimiKaif.newConversation",
        "title": "KIMI KRINIK: New Conversation",
        "icon": "$(add)"
      },
      {
        "command": "kimiKaif.showLogs",
        "title": "KIMI KRINIK: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "kimiKaif.resetKimi",
        "title": "KIMI KRINIK: Reset Kimi (in case of any issues/no response)",
        "icon": "$(refresh)"
      },
      {
        "command": "kimiKaif.logout",
        "title": "KIMI KRINIK: Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "kimiKaif.migrateLegacyData",
        "title": "KIMI KRINIK: Migrate Legacy Data"
      }
    ],
    "keybindings": [
      {
        "command": "kimiKaif.focusInput",
        "key": "ctrl+shift+k",
        "mac": "cmd+shift+k"
      },
      {
        "command": "kimiKaif.insertMention",
        "key": "alt+k",
        "mac": "alt+k",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kimi-kaif-sidebar",
          "title": "KIMI KRINIK",
          "icon": "resources/kimi-icon.svg"
        }
      ]
    },
    "views": {
      "kimi-kaif-sidebar": [
        {
          "type": "webview",
          "id": "kimiKaif.webview",
          "name": "KIMI KRINIK"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "kimiKaif.openInTab",
          "when": "view == kimiKaif.webview",
          "group": "navigation"
        },
        {
          "command": "kimiKaif.newConversation",
          "when": "view == kimiKaif.webview",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "kimiKaif.clearAllState",
          "when": "isDevelopment"
        },
        {
          "command": "kimiKaif.openInTab",
          "when": "true"
        },
        {
          "command": "kimiKaif.openInSideBar",
          "when": "true"
        },
        {
          "command": "kimiKaif.focusInput",
          "when": "true"
        },
        {
          "command": "kimiKaif.insertMention",
          "when": "true"
        },
        {
          "command": "kimiKaif.newConversation",
          "when": "true"
        },
        {
          "command": "kimiKaif.showLogs",
          "when": "true"
        },
        {
          "command": "kimiKaif.resetKimi",
          "when": "true"
        },
        {
          "command": "kimiKaif.logout",
          "when": "kimi.isLoggedIn"
        },
        {
          "command": "kimiKaif.migrateLegacyData",
          "when": "true"
        }
      ],
      "editor/context": [
        {
          "command": "kimiKaif.insertMention",
          "group": "moonshot-ai",
          "when": "editorTextFocus"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build",
    "dev": "pnpm run dev:prepare && pnpm run \"/^dev:(extension|webview)$/\"",
    "dev:prepare": "node scripts/prepare-dev.mjs",
    "dev:extension": "node scripts/watch-extension.mjs",
    "dev:webview": "vite build --config webview-ui/vite.config.ts --watch --sourcemap",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview-ui/tsconfig.json --noEmit",
    "build": "pnpm run build:extension && pnpm run build:webview",
    "build:webview": "vite build --config webview-ui/vite.config.ts",
    "build:extension": "tsdown --config tsdown.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:extension-host": "node scripts/extension-host-smoke.mjs",
    "package:platform": "node scripts/vsix-package.mjs",
    "package:verify": "node scripts/vsix-verify.mjs",
    "publish:vsix": "node scripts/vsix-publish.mjs",
    "publish:ovsx": "node scripts/ovsx-publish.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/diff": "^8.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-scroll-to-bottom": "^4.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/vscode": "1.100.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "acorn": "8.17.0",
    "jsdom": "^30.0.1",
    "ovsx": "1.0.2",
    "tailwindcss": "^4.1.4",
    "vite": "^6.3.3",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vitest": "4.1.4"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/inter": "5.2.8",
    "@moonshot-ai/kimi-code-oauth": "workspace:^",
    "@moonshot-ai/kimi-code-sdk": "workspace:^",
    "@moonshot-ai/kimi-telemetry": "workspace:^",
    "@moonshot-ai/migration-legacy": "workspace:^",
    "@radix-ui/react-accordion": "^1.2.12",
    "@tabler/icons-react": "^3.36.0",
    "@tanstack/react-query": "^5.74.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.2",
    "fuse.js": "^7.1.0",
    "heic-to": "^1.0.2",
    "immer": "^11.1.0",
    "katex": "^0.17.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-scroll-to-bottom": "^4.2.0",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^3.6.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "14.0.1",
    "zustand": "^5"
  }
}
